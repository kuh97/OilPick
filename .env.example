# ── 오피넷 ────────────────────────────────────────────
OPINET_CERT_KEY=여기에_오피넷_인증키

# ── Upstash Redis ──────────────────────────────────────
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxx...
REDIS_KEY_PREFIX=dev

# ── 카카오 ────────────────────────────────────────────
KAKAO_REST_API_KEY=여기에_카카오_REST_키
NEXT_PUBLIC_KAKAO_JS_KEY=여기에_카카오_JS_키

# ── DB ────────────────────────────────────────────────
DATABASE_URL=postgresql://...

# ── 앱 ────────────────────────────────────────────────
APP_BASE_URL=http://localhost:3000
CRON_SECRET=여기에_크론_시크릿

# ── Vercel Blob (일일 CSV 임포트, Phase D) ─────────────
# GitHub Actions가 CSV를 업로드하고 Vercel Cron이 읽어 임포트한다.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ── 선택 ──────────────────────────────────────────────
OPINET_CONCURRENCY=8
CACHE_BYPASS=false
